---
---

<div id="nebula-bg" aria-hidden="true"></div>
<div id="nebula-veil" aria-hidden="true"></div>
<div id="nebula-cursor" aria-hidden="true"></div>

<style>
  #nebula-bg {
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
  }
  #nebula-bg canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Softens the raw shader so body text stays readable over it. */
  #nebula-veil {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: color-mix(in srgb, var(--paper) 72%, transparent);
    backdrop-filter: blur(2px) saturate(1.15);
    -webkit-backdrop-filter: blur(2px) saturate(1.15);
  }
  #nebula-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 20px;
    height: 20px;
    margin: -10px 0 0 -10px;
    border-radius: 50%;
    background: rgba(15, 110, 86, 0.25);
    pointer-events: none;
    z-index: -1;
    opacity: 0;
    transform: translate(-100px, -100px);
    transition: opacity 0.2s ease;
  }
</style>

<script>
  import * as THREE from "three";

  const container = document.getElementById("nebula-bg");
  const cursor = document.getElementById("nebula-cursor");

  if (container) {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Resolve the WebGL context ourselves instead of letting WebGLRenderer negotiate
    // webgl2 → webgl internally: on some browser/GPU combos that fallback re-requests
    // a different context type on the same canvas, which throws.
    const canvas = document.createElement("canvas");
    const contextAttributes = { antialias: true, alpha: true };
    const gl =
      canvas.getContext("webgl2", contextAttributes) ??
      canvas.getContext("webgl", contextAttributes);

    if (gl) {
      const renderer = new THREE.WebGLRenderer({ canvas, context: gl, ...contextAttributes });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      container.appendChild(canvas);

      const scene = new THREE.Scene();
      const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
      const clock = new THREE.Clock();

      const vertexShader = `
        void main() {
          gl_Position = vec4(position, 1.0);
        }
      `;

      const fragmentShader = `
        precision highp float;
        uniform vec2 iResolution;
        uniform float iTime;
        uniform vec2 iMouse;

        float random(vec2 st) {
          return fract(
            sin(dot(st.xy, vec2(12.9898, 78.233))) * 43758.5453123
          );
        }

        float noise(vec2 p) {
          vec2 i = floor(p), f = fract(p);
          vec2 u = f * f * (3.0 - 2.0 * f);
          return mix(
            mix(random(i), random(i + vec2(1.0, 0.0)), u.x),
            mix(random(i + vec2(0.0, 1.0)), random(i + vec2(1.0, 1.0)), u.x),
            u.y
          );
        }

        float fbm(vec2 p) {
          float v = 0.0;
          float a = 0.5;
          for (int i = 0; i < 6; i++) {
            v += a * noise(p);
            p *= 2.0;
            a *= 0.5;
          }
          return v;
        }

        void main() {
          vec2 uv    = (gl_FragCoord.xy - 0.5 * iResolution.xy)
                       / iResolution.y;
          vec2 mouse = (iMouse      - 0.5 * iResolution.xy)
                       / iResolution.y;
          float t    = iTime * 0.1;

          float md = length(uv - mouse);
          vec2 offset = normalize(uv - mouse) / (md * 50.0);
          uv += offset * smoothstep(0.3, 0.0, md);

          float angle = t * 0.3;
          mat2 rot = mat2(
            cos(angle), -sin(angle),
            sin(angle),  cos(angle)
          );
          vec2 p = rot * uv;

          float c1 = fbm(p * 2.0 + vec2(t, -t));
          float c2 = fbm(p * 4.0 - vec2(-t, t));

          vec3 deepSpace  = vec3(0.0, 0.0, 0.05);
          vec3 gasColor1  = vec3(0.8, 0.2, 0.5);
          vec3 gasColor2  = vec3(0.2, 0.3, 0.9);
          vec3 color      = deepSpace;

          color = mix(color, gasColor1, smoothstep(0.4, 0.6, c1));
          color = mix(color, gasColor2, smoothstep(0.5, 0.7, c2) * 0.5);

          gl_FragColor = vec4(color, 1.0);
        }
      `;

      const uniforms = {
        iTime: { value: 0 },
        iResolution: { value: new THREE.Vector2() },
        iMouse: { value: new THREE.Vector2(-100, -100) },
      };
      const material = new THREE.ShaderMaterial({ vertexShader, fragmentShader, uniforms });
      const mesh = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), material);
      scene.add(mesh);

      const resize = () => {
        const width = container.clientWidth;
        const height = container.clientHeight;
        renderer.setSize(width, height);
        uniforms.iResolution.value.set(width, height);
      };
      window.addEventListener("resize", resize);
      new ResizeObserver(resize).observe(container);
      resize();

      const onMouseMove = (event: MouseEvent) => {
        const x = event.clientX;
        const y = container.clientHeight - event.clientY;
        uniforms.iMouse.value.set(x, y);
        if (cursor) {
          cursor.style.opacity = "1";
          cursor.style.transform = `translate(${event.clientX}px, ${event.clientY}px)`;
        }
      };
      window.addEventListener("mousemove", onMouseMove);

      const renderFrame = () => {
        uniforms.iTime.value = clock.getElapsedTime();
        renderer.render(scene, camera);
      };

      if (prefersReducedMotion) {
        // Respect reduced-motion: paint one static frame, no animation loop, no mouse warp.
        renderFrame();
      } else {
        renderer.setAnimationLoop(renderFrame);
        document.addEventListener("visibilitychange", () => {
          renderer.setAnimationLoop(document.hidden ? null : renderFrame);
        });
      }
    }
  }
</script>
